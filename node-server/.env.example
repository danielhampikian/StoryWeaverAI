# Copy this file to node-server/.env and fill in only what you need.
# Never commit your real .env file.

# Which AI provider writes the stories. Leave unset (or "mock") to use the free,
# offline mock generator, which needs no key and costs nothing.
# Options: mock | huggingface | openai-compatible | ollama | openai | anthropic
AI_PROVIDER=mock

# --- mock (default, free, offline) ---
# Artificial delay in milliseconds so the loading state is visible (default 800)
# MOCK_DELAY_MS=800

# --- huggingface (Hugging Face Inference Providers router) ---
# Token from https://huggingface.co/settings/tokens with "Make calls to Inference Providers" permission.
# Note: free HF accounts no longer include monthly inference credits (PRO includes $2/month).
# HF_TOKEN=hf_xxx
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- openai-compatible (any OpenAI-compatible API, including free tiers) ---
# OpenRouter free models (model ids ending in ":free"; see https://openrouter.ai/models):
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_API_KEY=sk-or-xxx
# OPENAI_COMPAT_MODEL=google/gemma-4-31b-it:free
#
# Groq free plan (key from https://console.groq.com/keys):
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=gsk_xxx
# OPENAI_COMPAT_MODEL=openai/gpt-oss-20b
#
# Google Gemini free tier (key from https://aistudio.google.com/apikey; pick a model marked free on the pricing page):
# OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_COMPAT_API_KEY=your-gemini-key
# OPENAI_COMPAT_MODEL=your-chosen-gemini-model

# --- ollama (free, runs models locally; install from https://ollama.com and run: ollama pull llama3.2) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- openai (paid credits required) ---
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini

# --- anthropic (paid credits required) ---
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-haiku-4-5

# Server port (the React dev server proxies /api to 5000)
# PORT=5000
